# Copy this file to .env and fill in the keys for the AI provider(s) you want to use.
# NEVER commit the .env file to version control.

# --- Anthropic Claude (paid) ---
# Get your key at: https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=
# --- Groq (free tier) ---
# Get your key at: https://console.groq.com → API Keys → New Key
GROQ_API_KEY=

# --- Google Gemini ---
# Get your key at: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# --- Ollama (local, no key needed) ---
# Default points to Ollama running on the host machine.
# Change only if Ollama is running elsewhere.
OLLAMA_BASE_URL=

# --- Ollama Cloud (paid, opt-in) ---
# Run bigger models on Ollama's hardware. Data LEAVES the machine when the
# "Ollama Cloud" provider is selected — it is a separate provider, clearly
# labelled CLOUD in the UI. Get your key at: https://ollama.com → Settings → Keys
OLLAMA_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com   # override only if needed

# Optional local-inference tuning (sensible defaults are used if left blank):
# OLLAMA_NUM_CTX=8192      # context window; lower to 4096 if the model runs on CPU
# MAX_IMAGES_LOCAL=3       # screenshots sent to local models (fewer = faster)
# OLLAMA_TIMEOUT=900       # max seconds to wait for local inference

# Optional generation tuning:
# MAX_STEPS=15             # max session steps sent to the model (raise for long sessions)
